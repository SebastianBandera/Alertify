<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.2</version>
        <relativePath/>
    </parent>

    <groupId>app.alertify</groupId>
    <artifactId>alertify-backend-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Alertify Backend Parent</name>
    <description>Alertify backend modules</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <grpc.version>1.83.1</grpc.version>
        <protobuf.version>4.33.2</protobuf.version>
        <playwright.version>1.62.0</playwright.version>
    </properties>

    <modules>
        <module>worker-contract</module>
        <module>worker-runtime</module>
        <module>alert-templates</module>
        <module>core</module>
        <module>worker-standard</module>
        <module>worker-playwright</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
    </build>
</project>
