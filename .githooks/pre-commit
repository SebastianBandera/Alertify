#!/usr/bin/env bash
# Activate this hook in each clone with: git config core.hooksPath .githooks

set -euo pipefail

allow_customizations="$(git config --bool --get alertify.allowCustomizations || true)"
staged_paths="$(mktemp)"
trap 'rm -f "$staged_paths"' EXIT

git diff --cached --name-only --diff-filter=ACMRT -z > "$staged_paths"

shopt -s nocasematch
blocked=0

while IFS= read -r -d '' path; do
    name="${path##*/}"
    reason=''

    case "$name" in
        .env.example|.env.template|.env.*.example|.env.*.template|*.env.example|*.env.template|*.env.*.example|*.env.*.template)
            ;;
        .env|.env.*|*.env|*.env.*)
            reason='local environment file'
            ;;
    esac

    if [[ -z "$reason" ]]; then
        case "$name" in
            *.key|*.pem|*.crt|*.cer|*.der|*.p12|*.pfx|*.jks|*.keystore)
                reason='local key or certificate'
                ;;
            bootstrap.properties|AGENTS.override.md)
                reason='local configuration'
                ;;
            *.class|*.jar|*.war|*.ear|*.nar|*.log|*.tsbuildinfo|*.tmp|*.temp|*.swp|*.swo)
                reason='generated or temporary artifact'
                ;;
        esac
    fi

    if [[ -z "$reason" ]]; then
        case "/$path/" in
            */.alertify/*|*/target/*|*/node_modules/*|*/dist/*|*/build/*|*/out/*|*/coverage/*|*/tmp/*|/logs/*|*/.angular/cache/*)
                reason='generated or local directory'
                ;;
            */frontend/public/config/*)
                reason='runtime file'
                ;;
        esac
    fi

    if [[ -z "$reason" ]]; then
        case "$path" in
            backend/core/src/main/java/app/alertify/services/secret/key/PrivateKeyPart.java)
                reason='generated private key fragment'
                ;;
        esac
    fi

    if [[ -n "$reason" ]]; then
        printf '  - %q (%s)\n' "$path" "$reason" >&2
        blocked=1
    fi
done < "$staged_paths"

customizations_blocked=0
if [[ "$allow_customizations" != true ]]; then
    # Disable rename detection so both moving a protected file away and moving
    # another file into its place are checked. Include deletions as well.
    git diff --cached --name-only --no-renames -z -- \
        frontend/src/app/core/alert-charts/alert-chart-extractors.extended.ts \
        frontend/src/app/core/alert-messages/alert-message-formatters.extended.ts \
        frontend/src/app/core/i18n/translations/en.extended.translations.ts \
        frontend/src/app/core/i18n/translations/es-uy.extended.translations.ts \
        ':(glob)backend/alert-templates/src/main/java/app/alertify/alerts/templates/custom/**/*.java' > "$staged_paths"

    while IFS= read -r -d '' path; do
        printf '  - %q (customization file; must not be committed to the original repository)\n' "$path" >&2
        blocked=1
        customizations_blocked=1
    done < "$staged_paths"
fi

if (( blocked )); then
    printf 'WARNING: Commit rejected. Remove the listed files from the staging area.\n' >&2
    if (( customizations_blocked )); then
        printf 'Extended frontend files and custom Java templates belong to local customizations, not the original repository.\n' >&2
        printf 'To version these customizations in a fork, run: git config --local alertify.allowCustomizations true\n' >&2
    fi
    exit 1
fi
