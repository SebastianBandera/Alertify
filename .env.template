# Isolated name Docker Compose will use for the project and its resources.
# Example: monitoring
COMPOSE_PROJECT_NAME=monitoring

# Host address on which local service ports will be published.
# Example: 127.0.0.1
BIND_ADDRESS=127.0.0.1

# Time zone used by the containers.
# Example: UTC
TIME_ZONE=UTC

# Base Keycloak image used to build the local optimized image.
# Example: quay.io/keycloak/keycloak:26.7.1
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.1

# Name of the optimized Keycloak image built locally.
# Example: monitoring-keycloak-optimized:26.7.1
KEYCLOAK_OPTIMIZED_IMAGE=monitoring-keycloak-optimized:26.7.1

# PostgreSQL image used by Keycloak's local database.
# Example: postgres:18.4-alpine
POSTGRES_IMAGE=postgres:18.4-alpine

# Base Redis image used to build the local cache.
# Example: redis:8.10.0-alpine
REDIS_IMAGE=redis:8.10.0-alpine

# Name of the Redis image built locally.
# Example: monitoring-cache:8.10.0
REDIS_LOCAL_IMAGE=monitoring-cache:8.10.0

# Selects whether Redis is started by this Compose project or reused externally.
# Allowed values: local | external
# Example: local
REDIS_MODE=local

# URL other components must use to connect to Redis.
# Local example: redis://cache:6379
# External example: rediss://redis.example.org:6380
REDIS_URL=redis://cache:6379

# Redis password. run.js generates a cryptographically secure secret.
CACHE_PASSWORD=<GENERATE_CACHE_PASSWORD>

# Maximum memory managed by Redis; it must remain below the container limit.
# Example: 1700mb
CACHE_MAX_MEMORY=1700mb

# Total memory limit for the local Redis container.
# Example: 2g
CACHE_CONTAINER_MEMORY=2g

# Selects whether Keycloak is started by this Compose project or reused externally.
# Allowed values: local | external
# Example: local
KEYCLOAK_MODE=local

# Public Keycloak URL, for either a local or external server.
# Local example: http://localhost:8081
# External example: https://sso.example.org
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Host port published by Keycloak when KEYCLOAK_MODE=local.
# Example: 8081
KEYCLOAK_HTTP_PORT=8081

# Selects the database used by the local Keycloak server.
# Allowed values: local | external
# Example: local
KEYCLOAK_DATABASE_MODE=local

# PostgreSQL host as seen from the Keycloak container.
# Local example: identity-database
# External example: postgres.example.org
IDENTITY_DB_HOST=identity-database

# PostgreSQL port as seen from the Keycloak container.
# Example: 5432
IDENTITY_DB_PORT=5432

# Host port published by PostgreSQL when KEYCLOAK_DATABASE_MODE=local.
# Example: 5434
IDENTITY_DB_HOST_PORT=5434

# Name of the database used by Keycloak.
# Example: keycloak
IDENTITY_DB_NAME=keycloak

# Database user used by Keycloak.
# Example: keycloak_app
IDENTITY_DB_USER=keycloak_app

# Keycloak database password. run.js generates a secure secret.
IDENTITY_DB_PASSWORD=<GENERATE_IDENTITY_DB_PASSWORD>

# Optional parameters appended to the JDBC URL; empty for the local database.
# External example: ?sslmode=require
IDENTITY_DB_JDBC_PARAMETERS=

# Temporary administrator removed after the permanent administrator is created.
# Example: temporary-bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=temporary-bootstrap-admin

# Temporary administrator password. run.js generates a secure secret.
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=<GENERATE_KEYCLOAK_BOOTSTRAP_PASSWORD>

# Permanent administrator of Keycloak's master realm.
# Example: kcadmin
KEYCLOAK_ADMIN_USERNAME=kcadmin

# Permanent administrator password. run.js generates a secure secret.
KEYCLOAK_ADMIN_PASSWORD=<GENERATE_KEYCLOAK_ADMIN_PASSWORD>

# Application realm imported from identity/realm-template.json.
# Example: monitoring
OIDC_REALM=monitoring

# Application display name shown by Keycloak.
# Example: Monitoring
APP_DISPLAY_NAME=Monitoring

# Public frontend URL allowed for OIDC redirects and CORS.
# Example: http://localhost:4200
APP_PUBLIC_URL=http://localhost:4200

# OIDC public client identifier used by the frontend.
# Example: monitoring-web
OIDC_FRONTEND_CLIENT_ID=monitoring-web

# Audience expected by the protected API.
# Example: monitoring-api
OIDC_BACKEND_AUDIENCE=monitoring-api

# Initial administrator username in the application realm.
# Example: admin
APP_ADMIN_USERNAME=admin

# Initial application administrator password. run.js generates a secure secret.
APP_ADMIN_PASSWORD=<GENERATE_APP_ADMIN_PASSWORD>

# Initial read-only user in the application realm.
# Example: viewer
APP_VIEWER_USERNAME=viewer

# Initial read-only user password. run.js generates a secure secret.
APP_VIEWER_PASSWORD=<GENERATE_APP_VIEWER_PASSWORD>
