COMPOSE_PROJECT_NAME=monitoring
BIND_ADDRESS=127.0.0.1
TIME_ZONE=Etc/UTC

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.1
KEYCLOAK_OPTIMIZED_IMAGE=monitoring-keycloak-optimized:26.7.1
POSTGRES_IMAGE=postgres:18.4-alpine

# Host ports used by the browser and DBeaver.
KEYCLOAK_HTTP_PORT=8081
IDENTITY_DB_HOST_PORT=5434
KEYCLOAK_PUBLIC_URL=http://localhost:8081

IDENTITY_DB_NAME=keycloak
IDENTITY_DB_USER=keycloak_app
IDENTITY_DB_PASSWORD=CHANGE_ME_IDENTITY_DB_PASSWORD

# This temporary account exists only while the permanent administrator is created.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=temporary-bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TEMPORARY_BOOTSTRAP_PASSWORD

# This permanent account administers Keycloak itself in the master realm.
KEYCLOAK_ADMIN_USERNAME=kcadmin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

# Application realm imported from identity/realm-template.json.
OIDC_REALM=monitoring
APP_DISPLAY_NAME=Monitoring
APP_PUBLIC_URL=http://localhost:4200
OIDC_FRONTEND_CLIENT_ID=monitoring-web
OIDC_BACKEND_AUDIENCE=monitoring-api

# Local users created inside the application realm.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_APP_ADMIN_PASSWORD
APP_VIEWER_USERNAME=viewer
APP_VIEWER_PASSWORD=CHANGE_ME_APP_VIEWER_PASSWORD
